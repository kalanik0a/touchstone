#!/usr/bin/env bash
# ts-ssh — Remote access with hardware-bound consent
# SPDX-License-Identifier: MIT
set -euo pipefail
TOUCHSTONE_LIB="$(cd "$(dirname "$0")/../lib" && pwd)"
source "$TOUCHSTONE_LIB/touchstone-core.sh"
[ $# -eq 0 ] && { echo "Usage: ts-ssh [ssh-args...] user@host [command]" >&2; exit 1; }
ts_launch_captured "ssh" ssh "$@"
